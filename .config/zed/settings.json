// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "assistant": {
    "default_model": {
      "provider": "openai",
      "model": "deepseek/deepseek-r1:free"
    },
    "version": "2"
  },
  "language_models": {
    "openai": {
      "api_url": "https://openrouter.ai/api/v1",
      "available_models": [
        {
          "name": "anthropic/claude-3.7-sonnet",
          "display_name": "Sonnet 3.7",
          "max_tokens": 200000
        },
        {
          "name": "deepseek/deepseek-chat-v3-0324:free",
          "display_name": "DeepSeek V3",
          "max_tokens": 131072
        },
        {
          "name": "deepseek/deepseek-r1:free",
          "display_name": "DeepSeek R1",
          "max_tokens": 163840
        },
        {
          "name": "openrouter/quasar-alpha",
          "display_name": "Quasar Alpha",
          "max_tokens": 1000000
        },
        {
          "name": "openrouter/optimus-alpha",
          "display_name": "Optimus Alpha",
          "max_tokens": 1000000
        }
      ],
      "version": "1"
    }
  },
  "wrap_guides": [80, 100],
  "show_whitespaces": "all",
  "git_diff": "true",
  "icon_theme": "VSCode Icons (Dark)",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "terminal": {
    "font_family": "MonaspiceNe Nerd Font Mono",
    "max_scroll_history_lines": 30000
  }
}
